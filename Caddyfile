(nanocore_transport) {
	transport http {
		# Retire well before NanoCore's configured 360s idle close, leaving room for stalls.
		keepalive 4s
	}
}

:{$CADDY_HTTP_PORT:8080} {
	@compressed {
		not path /api/workspaces/*/threads/*/events
	}
	encode @compressed gzip

	handle /api/workspaces/*/threads/*/events {
		reverse_proxy 127.0.0.1:{$OPENKIT_HTTP_PORT:4317} {
			import nanocore_transport
			flush_interval -1
		}
	}

	handle /api/nanohost/transport/* {
		respond 404
	}

	handle /api/* {
		reverse_proxy 127.0.0.1:{$OPENKIT_HTTP_PORT:4317} {
			import nanocore_transport
		}
	}

	handle /internal/* {
		reverse_proxy 127.0.0.1:{$OPENKIT_HTTP_PORT:4317} {
			import nanocore_transport
		}
	}

	handle /mcp {
		reverse_proxy 127.0.0.1:{$OPENKIT_HTTP_PORT:4317} {
			import nanocore_transport
		}
	}

	# Keep unsupported API paths out of the SPA without changing Gateway reachability (#209).
	@unsupported_api path /v1 /v1/* /api /internal /mcp/*
	handle @unsupported_api {
		header Content-Type application/json
		respond `{"error":{"type":"invalid_request_error","code":"not_found","message":"API route not found."}}` 404
	}

	@web_read method GET HEAD
	handle @web_read {
		root * /srv/web
		try_files {path} /index.html
		file_server
	}

	handle {
		header Content-Type application/json
		header Allow "GET, HEAD"
		respond `{"error":{"type":"invalid_request_error","code":"method_not_allowed","message":"Method not allowed."}}` 405
	}
}
