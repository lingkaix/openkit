{
  "name": "@openkit/knowledge-ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Shared knowledge browser. Adapters live in the host, not in this package.",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && cp src/knowledge.css dist/knowledge.css",
    "test": "vitest run --reporter=tap-flat",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "biome check .",
    "format": "biome check --write ."
  },
  "dependencies": {
    "react-aria-components": "1.22.1"
  },
  "peerDependencies": {
    "react": "^19.2.7"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "^24.19.2",
    "@types/react": "19.3.0",
    "jsdom": "^31.0.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "~6.0.3",
    "vitest": "^5.1.0"
  }
}
