{
  "name": "@openkit/protocol",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./digest": {
      "types": "./dist/digest.d.ts",
      "default": "./dist/digest.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run --reporter=tap-flat",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "generate:schema": "node --import tsx ./scripts/generate-json-schema.ts"
  },
  "dependencies": {
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "5.1.0",
    "ajv": "^8.20.0",
    "tsx": "^4.23.15",
    "vitest": "^5.1.0"
  }
}
