{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^ar_[0-9a-f]{8}-[0-9a-f]{4}-[57][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}(?![\\s\\S])"
    },
    "workspaceId": {
      "type": "string",
      "pattern": "^ws_[0-9a-f]{8}-[0-9a-f]{4}-[57][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}(?![\\s\\S])"
    },
    "threadId": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^th_[0-9a-f]{8}-[0-9a-f]{4}-[57][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}(?![\\s\\S])"
        },
        {
          "type": "null"
        }
      ]
    },
    "turnId": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^tu_[0-9a-f]{8}-[0-9a-f]{4}-[57][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}(?![\\s\\S])"
        },
        {
          "type": "null"
        }
      ]
    },
    "kind": {
      "type": "string",
      "enum": [
        "report",
        "diff",
        "file",
        "summary"
      ]
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "ready",
        "archived"
      ]
    },
    "summary": {
      "type": [
        "string",
        "null"
      ]
    },
    "version": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "content": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "format": {
              "type": "string",
              "enum": [
                "markdown",
                "text",
                "json"
              ]
            },
            "body": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "format",
            "body"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "format": {
              "type": "string",
              "const": "file"
            },
            "mediaType": {
              "type": "string",
              "maxLength": 255,
              "pattern": "^[A-Za-z0-9!#$&^_.+-]+\\/[A-Za-z0-9!#$&^_.+-]+$"
            },
            "byteLength": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1000000000
            }
          },
          "required": [
            "format",
            "mediaType",
            "byteLength"
          ],
          "additionalProperties": false
        }
      ]
    },
    "contentDigest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "lastMutationRequestId": {
      "type": "string",
      "minLength": 1
    },
    "origin": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "turn-output"
            },
            "threadId": {
              "type": "string",
              "pattern": "^th_[0-9a-f]{8}-[0-9a-f]{4}-[57][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}(?![\\s\\S])"
            },
            "turnId": {
              "type": "string",
              "pattern": "^tu_[0-9a-f]{8}-[0-9a-f]{4}-[57][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}(?![\\s\\S])"
            },
            "requestId": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "kind",
            "threadId",
            "turnId",
            "requestId"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "imported"
            },
            "sourceKind": {
              "type": "string",
              "const": "direct-import"
            },
            "sourceId": {
              "type": "string",
              "minLength": 1
            },
            "sourceDigest": {
              "type": "string",
              "pattern": "^sha256:[a-f0-9]{64}$"
            },
            "actor": {
              "anyOf": [
                {
                  "type": "object",
                  "properties": {
                    "kind": {
                      "type": "string",
                      "const": "user"
                    },
                    "id": {
                      "type": "string",
                      "pattern": "^usr_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}(?![\\s\\S])"
                    }
                  },
                  "required": [
                    "kind",
                    "id"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "kind": {
                      "type": "string",
                      "enum": [
                        "agent",
                        "integration",
                        "system"
                      ]
                    },
                    "id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "responsibleUserId": {
                      "anyOf": [
                        {
                          "type": "string",
                          "pattern": "^usr_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}(?![\\s\\S])"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    }
                  },
                  "required": [
                    "kind",
                    "id",
                    "responsibleUserId"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "kind": {
                      "type": "string",
                      "const": "automation"
                    },
                    "id": {
                      "type": "string",
                      "pattern": "^auto_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}(?![\\s\\S])"
                    },
                    "responsibleUserId": {
                      "anyOf": [
                        {
                          "type": "string",
                          "pattern": "^usr_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}(?![\\s\\S])"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    }
                  },
                  "required": [
                    "kind",
                    "id",
                    "responsibleUserId"
                  ],
                  "additionalProperties": false
                }
              ]
            },
            "requestId": {
              "type": "string",
              "minLength": 1
            },
            "recordedAt": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "kind",
            "sourceKind",
            "sourceId",
            "sourceDigest",
            "actor",
            "requestId",
            "recordedAt"
          ],
          "additionalProperties": false
        }
      ]
    },
    "createdAt": {
      "type": "string",
      "minLength": 1
    },
    "updatedAt": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "id",
    "workspaceId",
    "threadId",
    "turnId",
    "kind",
    "title",
    "status",
    "summary",
    "version",
    "content",
    "contentDigest",
    "lastMutationRequestId",
    "origin",
    "createdAt",
    "updatedAt"
  ],
  "additionalProperties": false
}