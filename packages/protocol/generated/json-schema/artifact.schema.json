{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "workspaceId": {
      "type": "string",
      "minLength": 1
    },
    "threadId": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "turnId": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "kind": {
      "type": "string",
      "enum": [
        "report",
        "diff",
        "file",
        "summary"
      ]
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "ready",
        "archived"
      ]
    },
    "summary": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "version": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "content": {
      "type": "object",
      "properties": {
        "format": {
          "type": "string",
          "enum": [
            "markdown",
            "text",
            "json"
          ]
        },
        "body": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "format",
        "body"
      ],
      "additionalProperties": false
    },
    "contentDigest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "lastMutationRequestId": {
      "type": "string",
      "minLength": 1
    },
    "origin": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "turn-output"
            },
            "threadId": {
              "type": "string",
              "minLength": 1
            },
            "turnId": {
              "type": "string",
              "minLength": 1
            },
            "requestId": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "kind",
            "threadId",
            "turnId",
            "requestId"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "imported"
            },
            "sourceKind": {
              "type": "string",
              "const": "direct-import"
            },
            "sourceId": {
              "type": "string",
              "minLength": 1
            },
            "sourceDigest": {
              "type": "string",
              "pattern": "^sha256:[a-f0-9]{64}$"
            },
            "actor": {
              "anyOf": [
                {
                  "type": "object",
                  "properties": {
                    "kind": {
                      "type": "string",
                      "const": "user"
                    },
                    "id": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "required": [
                    "kind",
                    "id"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "kind": {
                      "type": "string",
                      "enum": [
                        "agent",
                        "automation",
                        "integration",
                        "system"
                      ]
                    },
                    "id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "responsibleUserId": {
                      "anyOf": [
                        {
                          "type": "string",
                          "minLength": 1
                        },
                        {
                          "type": "null"
                        }
                      ]
                    }
                  },
                  "required": [
                    "kind",
                    "id",
                    "responsibleUserId"
                  ],
                  "additionalProperties": false
                }
              ]
            },
            "requestId": {
              "type": "string",
              "minLength": 1
            },
            "recordedAt": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "kind",
            "sourceKind",
            "sourceId",
            "sourceDigest",
            "actor",
            "requestId",
            "recordedAt"
          ],
          "additionalProperties": false
        }
      ]
    },
    "createdAt": {
      "type": "string",
      "minLength": 1
    },
    "updatedAt": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "id",
    "workspaceId",
    "threadId",
    "turnId",
    "kind",
    "title",
    "status",
    "summary",
    "version",
    "content",
    "contentDigest",
    "lastMutationRequestId",
    "origin",
    "createdAt",
    "updatedAt"
  ],
  "additionalProperties": false
}