{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "workspaceId": {
      "type": "string",
      "minLength": 1
    },
    "threadId": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "turnId": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "itemId": {
      "default": null,
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "agentId": {
      "default": null,
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "agentSessionId": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "packageSnapshotId": {
      "default": null,
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "schemaSnapshotId": {
      "default": null,
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "runtimeOriginRef": {
      "default": null,
      "anyOf": [
        {
          "type": "string",
          "pattern": "^rto_[a-f0-9]{24}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "runtimeCacheLineageRef": {
      "default": null,
      "anyOf": [
        {
          "type": "string",
          "pattern": "^rcl_[a-f0-9]{24}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "requestId": {
      "default": null,
      "anyOf": [
        {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
        },
        {
          "type": "null"
        }
      ]
    },
    "sourceIds": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "capabilityId": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "queued",
        "running",
        "succeeded",
        "failed",
        "denied",
        "aborted",
        "timed-out",
        "interrupted",
        "unknown"
      ]
    },
    "summary": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "errorCode": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "startedAt": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "completedAt": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "id",
    "workspaceId",
    "threadId",
    "turnId",
    "itemId",
    "agentId",
    "agentSessionId",
    "packageSnapshotId",
    "schemaSnapshotId",
    "runtimeOriginRef",
    "runtimeCacheLineageRef",
    "requestId",
    "sourceIds",
    "capabilityId",
    "status",
    "summary",
    "errorCode",
    "startedAt",
    "completedAt"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "anyOf": [
        {
          "not": {
            "properties": {
              "status": {
                "const": "queued"
              }
            },
            "required": [
              "status"
            ]
          }
        },
        {
          "properties": {
            "completedAt": {
              "type": "null"
            },
            "startedAt": {
              "type": "null"
            }
          }
        }
      ]
    },
    {
      "anyOf": [
        {
          "not": {
            "properties": {
              "status": {
                "const": "running"
              }
            },
            "required": [
              "status"
            ]
          }
        },
        {
          "properties": {
            "completedAt": {
              "type": "null"
            },
            "startedAt": {
              "type": "string"
            }
          }
        }
      ]
    },
    {
      "anyOf": [
        {
          "not": {
            "properties": {
              "status": {
                "enum": [
                  "succeeded",
                  "failed",
                  "denied",
                  "aborted",
                  "timed-out",
                  "interrupted",
                  "unknown"
                ]
              }
            },
            "required": [
              "status"
            ]
          }
        },
        {
          "properties": {
            "completedAt": {
              "type": "string"
            },
            "startedAt": {
              "type": "string"
            }
          }
        }
      ]
    }
  ],
  "description": "Capability call timestamp nullability is determined by status. Parsed-instant ordering of terminal timestamps is enforced by the canonical Zod schema because JSON Schema cannot compare sibling date-time values."
}