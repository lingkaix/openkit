{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^ws_[0-9a-f]{8}-[0-9a-f]{4}-[57][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}(?![\\s\\S])"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "kind": {
      "type": "string",
      "enum": [
        "code",
        "content",
        "personal-ops",
        "research",
        "operations",
        "general",
        "personal"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "archived"
      ]
    },
    "counts": {
      "type": "object",
      "properties": {
        "threadCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "artifactCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "knowledgeEntryCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "threadCount",
        "artifactCount",
        "knowledgeEntryCount"
      ],
      "additionalProperties": false
    },
    "importedFrom": {
      "type": "object",
      "properties": {
        "sourceDeploymentId": {
          "type": "string",
          "pattern": "^dep_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}(?![\\s\\S])"
        },
        "sourceWorkspaceId": {
          "type": "string",
          "pattern": "^ws_[0-9a-f]{8}-[0-9a-f]{4}-[57][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}(?![\\s\\S])"
        },
        "exportCreatedAt": {
          "type": "string",
          "minLength": 1
        },
        "manifestDigest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        }
      },
      "required": [
        "sourceDeploymentId",
        "sourceWorkspaceId",
        "exportCreatedAt",
        "manifestDigest"
      ],
      "additionalProperties": false
    },
    "createdAt": {
      "type": "string",
      "minLength": 1
    },
    "updatedAt": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "id",
    "name",
    "kind",
    "status",
    "counts",
    "createdAt",
    "updatedAt"
  ],
  "additionalProperties": false
}