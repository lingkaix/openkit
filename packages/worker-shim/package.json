{
  "name": "@openkit/worker-shim",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "bin": {
    "openkit-worker-shim": "./dist/bin/openkit-worker-shim.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run --reporter=tap-flat",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "biome check .",
    "format": "biome check --write ."
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "2.2.0",
    "@openkit/codex-app-server-schema": "workspace:*",
    "@openkit/config-schema": "workspace:*",
    "@openkit/protocol": "workspace:*",
    "@openkit/worker-protocol": "workspace:*"
  },
  "devDependencies": {
    "@deepseek-ai/dsh": "0.2.1-rc.5",
    "@openai/codex": "0.166.0",
    "@opencode/cli": "2.2.5",
    "@opencode/client": "2.2.5",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "5.1.0",
    "vitest": "^5.1.0"
  }
}
