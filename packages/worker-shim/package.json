{
  "name": "@openkit/worker-shim",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "bin": {
    "openkit-worker-shim": "./dist/bin/openkit-worker-shim.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run --reporter=tap-flat",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "biome check .",
    "format": "biome check --write ."
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "1.7.0",
    "@openkit/codex-app-server-schema": "workspace:*",
    "@openkit/protocol": "workspace:*",
    "@openkit/worker-protocol": "workspace:*"
  },
  "devDependencies": {
    "@deepseek-ai/dsh": "0.2.0-rc.2",
    "@openai/codex": "0.160.0",
    "@opencode/cli": "2.0.22",
    "@opencode/client": "2.0.22",
    "@types/node": "^25.6.0",
    "@vitest/coverage-v8": "4.1.4",
    "vitest": "^4.1.4"
  }
}
