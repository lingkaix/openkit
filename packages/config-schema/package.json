{
  "name": "@openkit/config-schema",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./mcp-credentials": {
      "types": "./dist/mcp-credentials.d.ts",
      "default": "./dist/mcp-credentials.js"
    },
    "./native-environment": {
      "types": "./dist/native-environment.d.ts",
      "default": "./dist/native-environment.js"
    },
    "./provider-subscription": {
      "types": "./dist/provider-subscription.d.ts",
      "default": "./dist/provider-subscription.js"
    },
    "./workspace-export": {
      "types": "./dist/workspace-export.d.ts",
      "default": "./dist/workspace-export.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run --reporter=tap-flat",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "biome check .",
    "format": "biome check --write ."
  },
  "dependencies": {
    "@openkit/protocol": "workspace:*",
    "@openkit/worker-protocol": "workspace:*",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "@vitest/coverage-v8": "4.1.4",
    "vitest": "^4.1.4"
  }
}
