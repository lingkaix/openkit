{
  "schemaVersion": 1,
  "providerProfile": {
    "requiredFields": ["id", "category", "displayName", "credentials", "endpoints"],
    "categories": ["agent", "mcp", "model", "repository", "custom"],
    "credentialFields": ["envVar", "authStyle", "headerName", "queryParam", "pathTemplate"],
    "authStyles": ["bearer", "header", "query", "path", "none"],
    "refreshStrategies": [
      "static",
      "external",
      "oauth2_refresh_token",
      "oauth2_client_credentials",
      "google_service_account_jwt"
    ],
    "gatewayDelegatedRefreshStrategies": [
      "oauth2_refresh_token",
      "oauth2_client_credentials",
      "google_service_account_jwt"
    ],
    "refreshMaterialKeys": ["refresh_token", "client_secret", "private_key"],
    "reservedEnvPrefixPattern": "^v[0-9]+_",
    "reservedProfileIds": ["github", "openai", "anthropic", "google", "aws", "azure"]
  }
}
