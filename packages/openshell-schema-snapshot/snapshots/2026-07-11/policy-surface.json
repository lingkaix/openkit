{
  "schemaVersion": 2,
  "upstreamSandboxPolicy": {
    "protocols": ["rest", "websocket", "graphql", "sql", "json-rpc", "mcp"],
    "enforcements": ["audit", "enforce"],
    "accessModes": ["read-only", "read-write", "full"]
  },
  "openKitSandboxPolicyMapping": {
    "version": 1,
    "requiredTopLevelKeys": [
      "version",
      "filesystem_policy",
      "landlock",
      "process",
      "network_policies"
    ],
    "filesystemPolicyKeys": ["include_workdir", "read_only", "read_write"],
    "networkPolicyEntryKeys": ["name", "binaries", "endpoints"],
    "endpointKeys": ["host", "port", "protocol", "enforcement", "access"],
    "protocols": ["rest"],
    "enforcements": ["enforce"],
    "accessModes": ["read-only", "read-write"],
    "providerLayerPrefix": "_provider_",
    "providersV2Required": true
  }
}
