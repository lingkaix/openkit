{
  "schemaVersion": 3,
  "upstreamProviderProfile": {
    "categories": [
      "other",
      "inference",
      "agent",
      "source_control",
      "messaging",
      "data",
      "knowledge"
    ],
    "builtInProfileIds": [
      "aws-bedrock",
      "claude-code",
      "codex",
      "copilot",
      "cursor",
      "deepinfra",
      "github",
      "google-cloud",
      "google-vertex-ai",
      "nvidia",
      "pypi"
    ],
    "genericProviderType": "generic",
    "authStyles": ["basic", "bearer", "header", "query", "path"],
    "refreshStrategies": [
      "static",
      "external",
      "oauth2_refresh_token",
      "oauth2_client_credentials",
      "google_service_account_jwt"
    ],
    "gatewayRefreshMaterialKeys": [
      "client_id",
      "refresh_token",
      "client_secret",
      "client_email",
      "private_key",
      "subject",
      "sub"
    ]
  },
  "openKitProviderProfileMapping": {
    "requiredFields": [
      "id",
      "display_name",
      "category",
      "credentials",
      "endpoints",
      "binaries",
      "inference_capable"
    ],
    "credentialPlaceholderPrefix": "openshell:resolve:env:",
    "categories": ["inference"],
    "credentialFields": [
      "name",
      "description",
      "env_vars",
      "required",
      "auth_style",
      "header_name",
      "query_param"
    ],
    "endpointFields": ["host", "port", "protocol", "enforcement", "rules"],
    "ruleFields": ["allow"],
    "restAllowRuleFields": ["method", "path"],
    "workerInferenceRules": [
      {
        "allow": {
          "method": "POST",
          "path": "/api/worker-inference/v1/chat/completions"
        }
      },
      {
        "allow": {
          "method": "POST",
          "path": "/api/worker-inference/v1/responses"
        }
      }
    ],
    "authStyles": ["bearer"],
    "reservedEnvPrefixPattern": "^v[0-9]+_[A-Za-z0-9_]+$"
  }
}
