// Custom OpenAI-compatible provider template. Source filename stays openai-compatible-custom.provider.jsonc for catalog snapshot provenance.
// Replace the placeholder baseUrl and create the matching vault reference before using this provider.
// Fresh data roots install this file as openai-compatible-custom.provider.jsonc.example so the provider loader does not admit it as an active first-boot profile.
{
  "id": "openai-compatible-custom",
  "displayName": "Custom OpenAI-Compatible",
  "kind": "custom",
  "baseUrl": "https://example.invalid/v1",
  "models": ["custom-model"],
  "secretRef": "vault://provider_openai_compatible_custom"
}
