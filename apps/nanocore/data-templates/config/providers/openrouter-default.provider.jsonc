// OpenRouter provider template.
// Create the matching vault reference before using this provider.
// The provider id and starter model are traceable to the vendored models.dev snapshot.
{
  "id": "openrouter",
  "displayName": "OpenRouter",
  "kind": "gateway",
  "baseUrl": "https://openrouter.ai/api/v1",
  "models": ["openai/gpt-5.1"],
  "secretRef": "vault://provider_openrouter"
}
