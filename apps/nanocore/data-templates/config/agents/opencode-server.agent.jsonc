{
  "schemaVersion": 1,
  "requiredFeatures": [],
  "id": "agent_opencode_server",
  "displayName": "OpenCode Agent",
  "runtime": {
    "kind": "opencode",
    "adapter": "opencode",
    "version": "1.18.1",
    "image": {
      "ref": "openkit/worker-opencode:dev",
      "pullPolicy": "if-not-present"
    },
    "binaries": [
      { "id": "openkit-worker-shim", "path": "/usr/local/bin/openkit-worker-shim" },
      { "id": "node", "path": "/usr/local/bin/node" },
      { "id": "opencode", "path": "/usr/local/bin/opencode" },
      {
        "id": "opencode-native",
        "path": "/usr/local/lib/node_modules/opencode-ai/bin/opencode.exe"
      }
    ]
  },
  "provider": {
    "ref": "openrouter",
    "model": "openai/gpt-5.1"
  },
  "profiles": [
    {
      "id": "default",
      "instructionsRef": "opencode",
      "skills": []
    }
  ],
  "defaultProfileId": "default",
  "skills": [],
  "mcp": [],
  "workspace": {
    "root": "."
  },
  "sandbox": {
    "filesystem": [],
    "network": [],
    "credentialDeclarations": [],
    "backend": {
      "allowedKinds": ["openshell"],
      "preferred": "openshell",
      "requiredCapabilities": ["trusted-worker-inference-relay"]
    }
  },
  "extensions": {}
}
