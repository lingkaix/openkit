{
  "name": "@openkit/nanocore",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "bin": {
    "openkit-operator": "dist/openkit-operator.js",
    "openkit-restore": "dist/openkit-restore.js"
  },
  "scripts": {
    "dev": "UV_THREADPOOL_SIZE=${UV_THREADPOOL_SIZE:-16} tsx watch src/index.ts",
    "build": "node scripts/build-source.mjs",
    "build:compiled": "node scripts/write-source-build-identity.mjs --invalidate && tsc && node scripts/build-control-store-worker.mjs",
    "start": "UV_THREADPOOL_SIZE=${UV_THREADPOOL_SIZE:-16} node dist/index.js",
    "operator": "tsx src/openkit-operator.ts",
    "data-root:restore": "tsx scripts/restore-data-root.ts",
    "physical-epoch:migrate": "tsx scripts/migrate-physical-epochs.ts",
    "workspace-storage:migrate": "tsx scripts/migrate-workspace-storage.ts",
    "task-checkpoint:clean": "tsx scripts/clean-cancelled-admission-task-checkpoints.ts",
    "openapi:generate": "tsx scripts/generate-openapi.ts",
    "openapi:validate": "tsx scripts/validate-openapi.ts",
    "openapi:check": "pnpm run openapi:generate && pnpm run openapi:validate && git diff --exit-code -- openapi/app-api.openapi.json",
    "test:e2e": "pnpm run build && vitest run --config vitest.e2e.config.ts",
    "test:e2e:smoke": "pnpm run build && vitest run --config vitest.e2e.smoke.config.ts",
    "test:e2e:real-codex": "pnpm run build && cd ../.. && node apps/nanocore/node_modules/vitest/vitest.mjs run --root apps/nanocore --config vitest.e2e.real-codex.config.ts",
    "test": "vitest run --reporter=tap-flat",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write ."
  },
  "dependencies": {
    "@a2ui/web_core": "0.15.0",
    "@better-auth/core": "1.6.16",
    "@better-auth/drizzle-adapter": "1.6.16",
    "@earendil-works/pi-ai": "0.99.2",
    "@hono/node-server": "^2.1.6",
    "@modelcontextprotocol/client": "2.4.0",
    "@modelcontextprotocol/core": "2.4.0",
    "@modelcontextprotocol/server": "2.4.0",
    "@napi-rs/canvas": "1.1.0",
    "@openkit/app-api-schemas": "workspace:*",
    "@openkit/config-schema": "workspace:*",
    "@openkit/models-dev-catalog": "workspace:*",
    "@openkit/policy-kernel": "workspace:*",
    "@openkit/protocol": "workspace:*",
    "@openkit/storage": "workspace:*",
    "@openkit/worker-protocol": "workspace:*",
    "@opentelemetry/api": "^1.10.0",
    "@opentelemetry/context-async-hooks": "^3.1.0",
    "@opentelemetry/core": "^3.1.0",
    "@opentelemetry/exporter-metrics-otlp-http": "0.301.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.301.0",
    "@opentelemetry/otlp-transformer": "0.301.0",
    "@opentelemetry/resources": "^3.1.0",
    "@opentelemetry/sdk-metrics": "3.1.0",
    "@opentelemetry/sdk-trace": "^3.1.0",
    "@pandatix/js-cvss": "0.4.4",
    "ajv": "^8.20.0",
    "better-auth": "1.6.16",
    "better-sqlite3": "^13.0.3",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.17",
    "jsonc-parser": "^3.3.1",
    "just-bash": "3.6.0",
    "markdown-it": "15.0.3",
    "pdfjs-dist": "6.5.438",
    "seek-bzip": "2.0.0",
    "tar-stream": "3.2.2",
    "undici": "^8.12.4",
    "yaml": "2.9.1",
    "yauzl": "3.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@hyperjump/json-schema": "^1.18.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.6",
    "@types/yauzl": "3.4.0",
    "@vitest/coverage-v8": "5.1.0",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "typescript6": "npm:typescript@^6.0.3",
    "vitest": "^5.1.0"
  }
}
