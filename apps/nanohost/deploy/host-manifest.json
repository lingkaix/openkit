{
  "schemaVersion": 2,
  "profileId": "openkit-nanohost-linux-v2-python3",
  "architectures": ["amd64", "arm64"],
  "requirements": [
    {
      "id": "platform",
      "class": "platform",
      "probe": "platform",
      "predicate": {
        "os": "Linux"
      },
      "timeoutSeconds": 10
    },
    {
      "id": "systemd",
      "class": "service-manager",
      "probe": "systemd",
      "predicate": {
        "active": true,
        "unit": "openkit-nanohost.service"
      },
      "timeoutSeconds": 10
    },
    {
      "id": "service-principal",
      "class": "service-manager",
      "probe": "service-principal",
      "predicate": {
        "user": "root",
        "requiredCapabilities": ["CAP_SYS_ADMIN", "CAP_NET_ADMIN"]
      },
      "timeoutSeconds": 10
    },
    {
      "id": "cgroup-v2",
      "class": "kernel",
      "probe": "cgroup-v2",
      "predicate": {
        "filesystem": "cgroup2fs"
      },
      "timeoutSeconds": 10
    },
    {
      "id": "namespaces",
      "class": "kernel",
      "probe": "namespaces",
      "predicate": {
        "names": ["mnt", "net"]
      },
      "timeoutSeconds": 10
    },
    {
      "id": "seccomp",
      "class": "kernel",
      "probe": "seccomp",
      "predicate": {
        "supported": true
      },
      "timeoutSeconds": 10
    },
    {
      "id": "containerd",
      "class": "executable",
      "probe": "executable",
      "predicate": {
        "path": "/usr/bin/containerd",
        "regularNonSymlink": true,
        "executable": true
      },
      "timeoutSeconds": 10
    },
    {
      "id": "dockerd",
      "class": "executable",
      "probe": "executable",
      "predicate": {
        "path": "/usr/bin/dockerd",
        "regularNonSymlink": true,
        "executable": true
      },
      "timeoutSeconds": 10
    },
    {
      "id": "docker",
      "class": "executable",
      "probe": "executable",
      "predicate": {
        "path": "/usr/bin/docker",
        "regularNonSymlink": true,
        "executable": true
      },
      "timeoutSeconds": 10
    },
    {
      "id": "git",
      "class": "executable",
      "probe": "executable",
      "predicate": {
        "path": "/usr/bin/git",
        "regularNonSymlink": true,
        "executable": true
      },
      "timeoutSeconds": 10
    },
    {
      "id": "slirp4netns",
      "class": "executable",
      "probe": "executable",
      "predicate": {
        "path": "/usr/bin/slirp4netns",
        "regularNonSymlink": true,
        "executable": true
      },
      "timeoutSeconds": 10
    },
    {
      "id": "docker-version",
      "class": "version",
      "probe": "docker-version",
      "predicate": {
        "path": "/usr/bin/docker",
        "minimum": "28.0"
      },
      "timeoutSeconds": 10
    },
    {
      "id": "git-version",
      "class": "version",
      "probe": "git-version",
      "predicate": {
        "path": "/usr/bin/git",
        "format": "git-version"
      },
      "timeoutSeconds": 10
    },
    {
      "id": "resolver",
      "class": "filesystem",
      "probe": "resolver",
      "predicate": {
        "path": "/run/systemd/resolve/resolv.conf",
        "usableNameserver": true
      },
      "timeoutSeconds": 10
    },
    {
      "id": "libc",
      "class": "libc",
      "probe": "libc",
      "predicate": {
        "executables": ["nanohost", "openshell-gateway"],
        "derive": "elf-version-needs"
      },
      "timeoutSeconds": 10
    },
    {
      "id": "ancestors",
      "class": "filesystem",
      "probe": "ancestors",
      "predicate": {
        "paths": [
          "/usr/lib/openkit/nanohost",
          "/usr/lib/openkit/openshell-gateway",
          "/etc/systemd/system/openkit-nanohost.service",
          "/etc/openkit/nanohost.env",
          "/var/lib/openkit/nanohost",
          "/run/openkit/nanohost",
          "/var/lib/openkit/nanohost-images",
          "/var/lib/openkit/nanohost-work",
          "/var/lib/openkit/nanohost-workspace-scan"
        ],
        "uid": 0,
        "forbidMode": 18
      },
      "timeoutSeconds": 10
    }
  ],
  "recommendation": {
    "scope": "combined-small-deployment",
    "availableLogicalCpus": 2,
    "availableMemoryBytes": 8589934592,
    "availableStorageBytes": 32212254720,
    "timeoutSeconds": 5
  }
}
