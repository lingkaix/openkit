[Unit]
Description=OpenKit NanoHost
StartLimitIntervalSec=0

[Service]
Type=simple
EnvironmentFile=/etc/openkit/nanohost.env
PrivateMounts=yes
InaccessiblePaths=/run/docker.sock
ExecStart=/usr/lib/openkit/nanohost
# Let systemd stop the service cgroup first so an intentional stop is not a MainPID SIGKILL failure.
# Then kill the complete slice without a slice stop job, which would cancel Restart=.
ExecStopPost=-/usr/bin/systemctl kill --signal=SIGKILL --kill-whom=all openkit-nanohost.slice
Slice=openkit-nanohost.slice
KillMode=control-group
Restart=always
RestartSec=5s
RestartSteps=5
RestartMaxDelaySec=5min
# Status 78 holds credential unavailability and admission HTTP 401. Restart= must not present either again.
RestartPreventExitStatus=78
TimeoutStopSec=30s
