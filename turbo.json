{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "globalDependencies": [
    ".mise.toml",
    "apps/nanohost/mise.toml",
    "biome.json",
    "package.json",
    "pnpm-workspace.yaml",
    "tsconfig.base.json"
  ],
  "globalPassThroughEnv": [
    "CARGO_HOME",
    "RUSTUP_HOME",
    "RUST_VERSION",
    "LINDERA_BUILD_DICTIONARY_CACHE_DIR",
    "RUSTUP_TOOLCHAIN"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "pnpm-lock.yaml", "tsconfig.base.json"],
      "outputs": ["dist/**", "build/**", ".next/**", "out/**"]
    },
    "@openkit/nanohost#build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "Cargo.toml", "Cargo.lock"],
      "outputs": ["target/debug/nanohost", "target/debug/nanohost.d"]
    },
    "test": {
      "dependsOn": ["^build", "^test"],
      "inputs": ["$TURBO_DEFAULT$", "pnpm-lock.yaml", "tsconfig.base.json"],
      "outputs": ["coverage/**"]
    },
    "typecheck": {
      "dependsOn": ["^build", "^typecheck"],
      "inputs": ["$TURBO_DEFAULT$", "pnpm-lock.yaml", "tsconfig.base.json"],
      "outputs": []
    },
    "lint": {
      "dependsOn": [],
      "inputs": ["$TURBO_DEFAULT$"],
      "outputs": []
    },
    "format": {
      "dependsOn": [],
      "inputs": ["$TURBO_DEFAULT$"],
      "outputs": []
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "clean": {
      "cache": false
    },
    "@openkit/retrieval-kernel#build": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "../../Cargo.toml",
        "../../Cargo.lock",
        "../../scripts/retrieval-cargo.sh",
        "../../scripts/retrieval-dictionary.py"
      ],
      "outputs": ["../../target/debug/retrieval-kernel"]
    },
    "@openkit/nanocore#test": {
      "dependsOn": ["^build", "^test", "@openkit/retrieval-kernel#build"],
      "outputs": ["coverage/**"]
    }
  }
}
