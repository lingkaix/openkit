# Based on github/gitignore templates for Node, Python, Go, Rust,
# Global/VisualStudioCode, and Global/JetBrains, with monorepo-specific
# additions for Turborepo, mise, Bun, Zig, and native/WASM builds.

# OS-generated files
.DS_Store
Thumbs.db
Desktop.ini

# Playwright artifacts
**/test-results/
**/playwright-report/
**/playwright/.cache/

# Editor and IDE files
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
!.vscode/*.code-snippets
!*.code-workspace
.vscode-test/
.idea/**/workspace.xml
.idea/**/tasks.xml
.idea/**/usage.statistics.xml
.idea/**/dictionaries
